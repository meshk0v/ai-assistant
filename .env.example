# Ключ API Anthropic: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Необязательные настройки
PORT=3000
LLM_MODEL=claude-opus-5-5
# Глубина рассуждений: low | medium | high | xhigh | max (выше — точнее, но медленнее и дороже)
LLM_EFFORT=low
LLM_MAX_TOKENS=16000
# LLM_SYSTEM_PROMPT="Ты — ассистент компании ..."
# Сайты, которым разрешено обращаться к этому серверу (если фронтенд на GitHub Pages)
# ALLOWED_ORIGINS=https://meshk0v.github.io
